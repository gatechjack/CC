# --- Required for LLM agents (always) ---
ANTHROPIC_API_KEY=

# --- Telegram (optional; CEO falls back to CLI mode if absent) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Robinhood (Phase 3; required for live PMCC) ---
ROBINHOOD_USERNAME=
ROBINHOOD_PASSWORD=
ROBINHOOD_MFA_SECRET=

# --- Coinbase Advanced Trade (Phase 3; required for live crypto) ---
COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_PASSPHRASE=

# --- Fidelity (Phase 3; Playwright session) ---
FIDELITY_USERNAME=
FIDELITY_PASSWORD=

# --- Mode flag (PAPER or LIVE) — main.py overrides; this is just a hint ---
TRADING_MODE=PAPER

# --- Database (override only if not using local SQLite) ---
TRADING_CORP_DB_URL=sqlite:///data/trading_corp.db
