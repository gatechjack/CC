//@version=6
// Paper Trade Visualizer for the bitunix_futures division.
//
// Display-only review tool. Renders historical paper_trade_record rows
// as entry/SL/TP lines + outcome-coloured boxes + entry/exit labels on
// the TradingView chart so the operator can visually scan for patterns
// where the model performs well vs poorly.
//
// Workflow:
//   1) python scripts/export_paper_trades_to_pinescript.py --since 7d
//      → writes scripts/pinescript/paper_trades_pine.txt
//   2) Copy the contents of paper_trades_pine.txt and paste it BETWEEN
//      the BEGIN/END GENERATED PASTE BLOCK markers below, replacing the
//      placeholder empty-array declarations.
//   3) Add to TradingView chart (BTCUSDT.P, 3m). Trades render on the
//      first bar of the chart.
//
// See scripts/pinescript/README.md for full operator notes.
indicator(
   "Paper Trade Visualizer",
   overlay = true,
   max_lines_count = 500,
   max_labels_count = 500,
   max_boxes_count = 500
   )

// ── User inputs ─────────────────────────────────────────────────────
// max=100 because Pine v6 caps max_lines_count at 500 and we draw up
// to 5 lines per trade (entry + SL + TP1 + TP2 + TP3). Turn TPs off
// below to view ~250 trades.
show_last_n      = input.int(50, "Show last N trades", minval = 1, maxval = 100)
show_entry_label = input.bool(true, "Show entry labels (order_id + side + validators)")
show_exit_label  = input.bool(true, "Show exit labels (R-multiple + $PnL)")
show_tp_lines    = input.bool(true, "Show TP1/TP2/TP3 lines")
show_rr_box      = input.bool(true, "Show SL→TP3 risk-reward box")

// ── Color palette ──────────────────────────────────────────────────
// Outcome shading (used for the entry→exit fill box):
c_win   = color.new(color.lime,   45)
c_loss  = color.new(color.red,    45)
c_expir = color.new(color.gray,   55)
c_open  = color.new(color.yellow, 55)
// Levels (lower alpha = more opaque, more prominent):
c_entry = color.new(color.aqua,    0)
c_sl    = color.new(color.red,     0)
c_tp1   = color.new(color.lime,    0)
c_tp2   = color.new(color.lime,   25)
c_tp3   = color.new(color.lime,   45)
// Borders:
c_border = color.new(color.white, 40)
// SL→TP3 risk-reward outer box: very subtle, just a dotted outline + faint tint.
c_rr_box_fill   = color.new(color.purple, 92)
c_rr_box_border = color.new(color.purple, 50)

// === BEGIN GENERATED PASTE BLOCK ===
// Generator: scripts/export_paper_trades_to_pinescript.py
// Generated: 2026-05-30T06:24:25.939221+00:00
// Division : bitunix_futures
// Window   : 2026-05-23T06:24:25.936767+00:00 -> 2026-05-30T06:24:25.936807+00:00
// Trades   : 14 (11 win / 3 loss / 0 expired / 0 open)
var int g_count = 14
var array<int> g_entry_ts = array.from(1779898028000, 1779904818000, 1779920024000, 1779928209000, 1779930952000, 1779938286000, 1779940802000, 1779944765000, 1779975721000, 1779981734000, 1779995163000, 1780064031000, 1780077062000, 1780084690000)
var array<int> g_result_ts = array.from(1779898020000, 1779905640000, 1779920160000, 1779931080000, 1779931080000, 1779938280000, 1779940920000, 1779944760000, 1779975840000, 1779985260000, 1779996600000, 1780064760000, 1780078980000, 1780086600000)
var array<float> g_entry_price = array.from(75189.8, 74828.4, 74558.3, 74442.2, 74438.2, 73958.2, 73231.8, 73058, 72929, 72828.8, 73557.9, 73046.5, 73960, 73593.5)
var array<float> g_sl_price = array.from(75444.6949, 74987.1142, 74771.52329823, 74592.7211, 74602.5191, 74118.73144065, 72990.02845259, 73199.129, 73071.17327472, 73192.1144, 73746.67895, 73243.62325, 74132.13546378, 73730.39675)
var array<float> g_tp1_price = array.from(75054.45836, 74693.70888, 74424.09506, 74308.20404, 74304.21124, 73825.07524, 73363.61724, 72926.4956, 72797.7278, 72647.1428, 73425.49578, 72915.0163, 73826.872, 73461.0317)
var array<float> g_tp2_price = array.from(74934.9051, 74669.6858, 74345.07670177, 74291.6789, 74273.8809, 73797.66855935, 73473.57154741, 72916.871, 72786.82672528, 72592.2144, 73353.27895, 72849.37675, 73787.86453622, 73456.60325)
var array<float> g_tp3_price = array.from(74552.56275, 74431.6145, 74025.24175443, 74065.89725, 74027.40225, 73556.87139837, 73836.22886851, 72705.1775, 72573.56681319, 71920.514, 73085.952625, 72553.691875, 73529.66134056, 73251.258125)
var array<float> g_result_price = array.from(75189.8, 74693.70888, 74424.09506, 74308.20404, 74304.21124, 73556.87139837, 72990.02845259, 72926.4956, 72797.7278, 73192.1144, 73557.9, 72553.691875, 73826.872, 73730.39675)
var array<float> g_r_multiple = array.from(0.1328, 0.9244, 0.8146, 0.9451, 0.9076, 1.3322, -1, 0.966, 0.9616, -1, 0.1752, 1.2917, 0.8866, -1)
var array<float> g_pnl_dollars = array.from(0.06516854, 0.08869456, 0.10538305, 0.06538607, 0.07002266, 0.10229915, -0.37373861, 0.06601095, 0.21221019, -0.17647857, 0.05091488, 0.11133767, 0.06667125, -0.05747768)
var array<string> g_side = array.from("sell", "sell", "sell", "sell", "sell", "sell", "buy", "sell", "sell", "sell", "sell", "sell", "sell", "sell")
var array<string> g_result = array.from("win", "win", "win", "win", "win", "win", "loss", "win", "win", "loss", "win", "win", "win", "loss")
var array<string> g_validator_pair = array.from("V+VOL+S", "V+VOL+S", "V+VOL+S", "V+VOL+S", "V+VOL+S", "V+S/-VOL", "VOL+S/-V", "V+S/-VOL", "V+VOL/-S", "V+VOL/-S", "VOL+S/-V", "V+VOL/-S", "VOL+S/-V", "VOL+S/-V")
var array<string> g_order_id_short = array.from("cb19b9ad", "28f43f1e", "0b118801", "2007d2c9", "6daca683", "c8f25d17", "99d62e04", "0acb8e5b", "aaaefb0f", "496901ae", "5897a0ae", "86a9a531", "5150fa62", "218b1aae")
// === END GENERATED PASTE BLOCK ===

// ── Helpers ────────────────────────────────────────────────────────
f_result_color(string res) =>
    res == "win" ? c_win : res == "loss" ? c_loss : res == "expired" ? c_expir : c_open

f_side_arrow(string side) =>
    side == "buy" ? "▲" : "▼"

f_signed(float x, string fmt) =>
    (x >= 0 ? "+" : "") + str.tostring(x, fmt)

// ── Render once on first bar ──────────────────────────────────────
// Pine's drawing-object pool is finite (max_lines/labels/boxes_count);
// keep the work inside `barstate.isfirst` so we draw once, not per bar.
if barstate.isfirst and g_count > 0
    start_i = math.max(0, g_count - show_last_n)
    for i = start_i to g_count - 1
        et     = array.get(g_entry_ts,        i)
        rt_raw = array.get(g_result_ts,       i)
        ep     = array.get(g_entry_price,     i)
        sl     = array.get(g_sl_price,        i)
        tp1    = array.get(g_tp1_price,       i)
        tp2    = array.get(g_tp2_price,       i)
        tp3    = array.get(g_tp3_price,       i)
        rp     = array.get(g_result_price,    i)
        rmult  = array.get(g_r_multiple,      i)
        pnl    = array.get(g_pnl_dollars,     i)
        side   = array.get(g_side,            i)
        res    = array.get(g_result,          i)
        vp     = array.get(g_validator_pair,  i)
        oid    = array.get(g_order_id_short,  i)

        // 0-sentinel for result_ts means "still open" → extend to now.
        rt = rt_raw == 0 ? timenow : rt_raw
        // Outcome box uses entry-price when the position is still open
        // (no exit price yet).
        rp_eff = rp > 0 ? rp : ep
        rc     = f_result_color(res)

        // Entry-price line (solid, thick)
        line.new(et, ep, rt, ep,
             xloc = xloc.bar_time, color = c_entry, width = 3)

        // Stop-loss line (solid, width 2)
        line.new(et, sl, rt, sl,
             xloc = xloc.bar_time, color = c_sl, width = 2)

        // TP1 / TP2 / TP3 lines (dashed, alpha-scaled by leg, width 2)
        if show_tp_lines and tp1 > 0
            line.new(et, tp1, rt, tp1,
                 xloc = xloc.bar_time, color = c_tp1, style = line.style_dashed, width = 2)
        if show_tp_lines and tp2 > 0
            line.new(et, tp2, rt, tp2,
                 xloc = xloc.bar_time, color = c_tp2, style = line.style_dashed, width = 2)
        if show_tp_lines and tp3 > 0
            line.new(et, tp3, rt, tp3,
                 xloc = xloc.bar_time, color = c_tp3, style = line.style_dashed, width = 2)

        // SL→TP3 risk-reward outer box (drawn FIRST so the outcome
        // box renders on top of it). Spans the full SL↔TP3 range,
        // entry-time to exit-time. Light purple tint + dotted border.
        if show_rr_box and sl > 0 and tp3 > 0
            rr_top = math.max(sl, tp3)
            rr_bot = math.min(sl, tp3)
            box.new(et, rr_top, rt, rr_bot,
                 xloc = xloc.bar_time,
                 bgcolor = c_rr_box_fill,
                 border_color = c_rr_box_border,
                 border_style = line.style_dotted)

        // Outcome fill box (entry → exit price, coloured by result)
        box.new(et,    math.max(ep, rp_eff),
                rt,    math.min(ep, rp_eff),
             xloc = xloc.bar_time,
             bgcolor = rc, border_color = c_border)

        // Entry label: order_id (short) + side arrow + validator-pair tag
        if show_entry_label
            entry_txt = oid + " " + f_side_arrow(side) + " " + vp
            label.new(et, ep, entry_txt,
                 xloc = xloc.bar_time, yloc = yloc.price,
                 style = label.style_label_right,
                 color = color.new(color.black, 70),
                 textcolor = color.white,
                 size = size.normal)

        // Exit label: signed R-multiple + signed $PnL. Skip if still open.
        if show_exit_label and res != "open"
            exit_txt = f_signed(rmult, "0.00") + "R  " +
                       (pnl >= 0 ? "+$" : "-$") + str.tostring(math.abs(pnl), "0.00")
            label.new(rt, rp_eff, exit_txt,
                 xloc = xloc.bar_time, yloc = yloc.price,
                 style = label.style_label_left,
                 color = rc,
                 textcolor = color.white,
                 size = size.normal)

// No per-bar plotting; the indicator is purely an overlay of drawings.
// `na` ensures we don't add an extra series to the legend.
plot(na, title = "paper trades", color = color.new(color.black, 100))
