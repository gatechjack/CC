# ITEM 1 secrets.py — RH creds from Key Vault with EXPLICIT precedence:
#   KV AUTHORITATIVE, unit-env FALLBACK (operator decision 2026-07-18).
# File: trading_corp/utils/secrets.py  (`expected_env_vars` tuple ~285-322 + the KV pull
# loop ~324-338). RESTART-gated (batch).
#
# WHY not strict single-source: a KV / managed-identity hiccup at boot would otherwise
# degrade to NO creds = the 4-day outage we just fixed. Fallback makes a KV blip a
# non-event. Both sources are root-protected, so the purity cost is small.
#
# Default behavior for ALL OTHER secrets is UNCHANGED (env precedence, for local override).
# Only the RH creds are made KV-authoritative-with-fallback, explicitly.
#
# No-MFA: this account has no ROBINHOOD-MFA-SECRET in KV. Keeping it in the set is harmless
# (KV miss -> graceful skip -> robinhood_mfa_secret stays None, already handled everywhere).

--- a/trading_corp/utils/secrets.py
+++ b/trading_corp/utils/secrets.py
@@ (expected_env_vars tuple, after "FIDELITY_ACCOUNT",) @@
         "EODHD_API_KEY",
         "FIDELITY_USERNAME",
         "FIDELITY_PASSWORD",
         "FIDELITY_ACCOUNT",
+        "ROBINHOOD_USERNAME",
+        "ROBINHOOD_PASSWORD",
+        "ROBINHOOD_MFA_SECRET",
         "TRADING_CORP_DB_URL",

@@ (just before the KV pull loop, ~line 324) @@
+    # KV-authoritative-with-fallback set (operator decision 2026-07-18): for these, KV
+    # OVERWRITES any unit-env value; if KV has nothing/errs, the unit-env value survives as
+    # a break-glass FALLBACK (a KV/MI blip must NOT strand RH auth -> the 4-day outage).
+    _KV_AUTHORITATIVE = frozenset({
+        "ROBINHOOD_USERNAME", "ROBINHOOD_PASSWORD", "ROBINHOOD_MFA_SECRET",
+    })
     loaded = 0
     for env_name in expected_env_vars:
-        if os.getenv(env_name):
-            # Already set — env takes precedence so local overrides work
-            continue
+        authoritative = env_name in _KV_AUTHORITATIVE
+        if os.getenv(env_name) and not authoritative:
+            # Default: env takes precedence so local overrides work.
+            continue
         kv_name = env_name.replace("_", "-")
         try:
             secret = client.get_secret(kv_name)
             if secret.value:
-                os.environ[env_name] = secret.value
+                os.environ[env_name] = secret.value   # authoritative names: KV overwrites env
                 loaded += 1
+            # authoritative + KV empty/missing -> leave any existing unit-env value as fallback
         except Exception as e:
             # Secret not in vault, or transient auth failure — degrade gracefully
+            # (for RH creds this is the FALLBACK path: the unit-env value, if any, stays)
             log.debug("Key Vault: skipped %s (%s): %s",
                       kv_name, type(e).__name__, str(e)[:120])
