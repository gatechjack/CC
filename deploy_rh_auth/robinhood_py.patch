# ITEM 3 (revised) — brokers/robinhood.py: active 401 sentinel + guarded in-process
# re-login (self-heal) + state-change latch + alert hook. RESTART-gated (batch).
#
# Design: the broker DETECTS a 401 (active sentinel — robin_stocks swallows it silently),
# attempts ONE guarded in-process re-login off the pickle file (recovers with NO push if
# the timer kept the file fresh), and on a genuine down/recovered TRANSITION fires an alert
# hook (data_exec emits audit+telegram). snapshot() NEVER raises for auth (callers keep
# working; an unrecovered 401 yields the existing empty snapshot, equity=0). Broker-wide:
# all 4 RH divisions share this class + the one robin_stocks session.
#
# GUARD 1 (login-storm): _attempt_reauth backs off via _reauth_last_ts — at most one
#   re-login per _REAUTH_MIN_INTERVAL_S. Governs the ATTEMPT, not just the alert. (Hammering
#   RH login on a real outage = 429, the fragile-path failure.)
# GUARD 2 (no-blocking): the re-login runs under asyncio.wait_for(_REAUTH_TIMEOUT_S) so a
#   challenge/poll (stale file) can't stall the loop; the engine's stdin is systemd-null so
#   an sms/email input() raises EOFError (thread returns, no leak) rather than hanging.
#   A FRESH-file fast-path validates in <1s, so the short timeout cleanly separates
#   "silent recover" from "needs push -> alert".

=== 1. add near the module-level login state (after line 44, `_ACCOUNT_LIST`) ===
+import os
+import sys
+import time
+from trading_corp.utils.timeutil import iso, now_utc   # match the helper used elsewhere
+
+# --- ITEM 3: process-wide RH auth-health state (shared across all RH divisions) ---
+_AUTH_LOCK = Lock()
+_auth_down = False               # True once a 401 is detected and reauth hasn't recovered
+_auth_down_since: str | None = None
+_auth_last_good: str | None = None
+_reauth_last_ts = 0.0            # monotonic; GUARD 1 backoff anchor
+_REAUTH_MIN_INTERVAL_S = 300     # >= a real outage cools before we hit /login again (429 guard)
+_REAUTH_TIMEOUT_S = 15           # GUARD 2: fresh-file validate <1s; a stale-file challenge exceeds this
+# Set by main.py wiring to data_exec._on_rh_auth_change (async (down: bool, info: dict)).
+_auth_alert_hook = None

